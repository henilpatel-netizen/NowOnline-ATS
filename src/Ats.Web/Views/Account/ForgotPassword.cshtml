@model Ats.Web.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<h1 class="h4 mb-3 text-center">Forgot password</h1>
@if (Model.Sent)
{
    <p class="mb-0" role="status">If an account exists for that address, we have sent a link. It expires in 1 hour.</p>
}
else
{
    <p class="ats-small ats-muted">Enter your email address and we will send you a link to choose a new password.</p>
    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" role="alert" class="text-danger small mb-2"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Send reset link</button>
    </form>
}
<p class="text-center mt-3 mb-0 small"><a asp-action="Login">Back to sign in</a></p>
