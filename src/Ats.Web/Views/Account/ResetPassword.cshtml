@model Ats.Web.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "Choose a new password"; }
<h1 class="h4 mb-3 text-center">Choose a new password</h1>
@if (!Model.LinkUsable)
{
    <p role="alert">This link is invalid or has expired. Request a new one.</p>
    <a asp-action="ForgotPassword" class="btn btn-primary w-100">Request a new link</a>
}
else
{
    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" role="alert" class="text-danger small mb-2"></div>
        <input type="hidden" asp-for="Token" />
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Set new password</button>
    </form>
}
<p class="text-center mt-3 mb-0 small"><a asp-action="Login">Back to sign in</a></p>
