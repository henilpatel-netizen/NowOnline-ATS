@model Ats.Application.Dashboard.DashboardSummary
@using Ats.Web.Models.Shared
@using Ats.Domain.Enums
@{
    ViewData["Title"] = "Dashboard";
    ViewData["EyebrowUtc"] = DateTimeOffset.UtcNow;
    var maxStage = Model.ByStage.Count == 0 ? 1 : Math.Max(1, Model.ByStage.Max(s => s.Count));
    var attention = Model.NeedsAttention.Where(i => User.Can(i.RequiredPermission)).ToList();
    string SourceLabel(ApplicationOrigin o) => o switch
    {
        ApplicationOrigin.CareerSite => "Career site",
        ApplicationOrigin.Referral => "ReferralTool",
        ApplicationOrigin.Manual => "Added manually",
        _ => "Other"
    };
}

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3"><partial name="Partials/_StatTile" model="@(new StatTileModel("Open jobs:", Model.OpenJobs.ToString()))" /></div>
    <div class="col-sm-6 col-xl-3"><partial name="Partials/_StatTile" model="@(new StatTileModel("Active applications:", Model.ActiveApplications.ToString(), null, Model.TotalCandidates + " candidates total", "group"))" /></div>
    <div class="col-sm-6 col-xl-3"><partial name="Partials/_StatTile" model="@(new StatTileModel("Time to hire:", Model.TimeToHireDays?.ToString() ?? "—", Model.TimeToHireDays is null ? null : " days"))" /></div>
    <div class="col-sm-6 col-xl-3"><partial name="Partials/_StatTile" model="@(new StatTileModel("Offer acceptance:", Model.OfferAcceptanceRate?.ToString() ?? "—", Model.OfferAcceptanceRate is null ? null : "%"))" /></div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="ats-card d-flex flex-column">
            <span class="ats-eyebrow">Across all open jobs:</span>
            <h2 class="mt-1 mb-3">Pipeline right now.</h2>
            @if (Model.ByStage.Count == 0)
            {
                <partial name="Partials/_EmptyState" model="@(new EmptyStateModel("view_week", "No active applications yet."))" />
            }
            else
            {
                <div class="d-flex flex-column gap-2 mb-3">
                    @for (var i = 0; i < Model.ByStage.Count; i++)
                    {
                        var s = Model.ByStage[i];
                        <div class="ats-pipebar-row">
                            <span class="ats-pipebar-row-label" title="@s.Stage">@s.Stage</span>
                            <span class="ats-pipebar-row-track"><span class="ats-pipebar-row-fill ats-stage-@(i % 5 + 1)" style="width:@(s.Count * 100 / maxStage)%"></span></span>
                            <span class="ats-pipebar-row-count">@s.Count</span>
                        </div>
                    }
                </div>
            }
            @if (Model.Sources.Count > 0)
            {
                <div class="ats-stat-strip ats-divider-top mt-auto pt-3">
                    @foreach (var src in Model.Sources)
                    {
                        <span><span class="ats-eyebrow">@SourceLabel(src.Origin)</span><span class="ats-stat-mini">@src.Percent%</span></span>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5 d-flex flex-column gap-3">
        <div class="ats-card">
            <span class="ats-eyebrow">Needs you:</span>
            <h2 class="mt-1 mb-2">Open loops.</h2>
            @if (attention.Count == 0)
            {
                <p class="ats-small ats-muted mb-0">Nothing needs you right now.</p>
            }
            else
            {
                <div class="d-flex flex-column">
                    @foreach (var item in attention)
                    {
                        var tone = item.Tone switch { "danger" => "ats-pill--danger", "warning" => "ats-pill--warning", _ => "ats-pill--info" };
                        <a href="@item.Url" class="ats-attention-link d-flex align-items-center gap-3 py-2 px-1">
                            <span class="ats-pill ats-pill-icon @tone"><span class="ms ms-sm">@item.Icon</span></span>
                            <span class="ats-cell-stack flex-grow-1">
                                <span class="ats-small">@item.Headline</span>
                                <span class="ats-xsmall ats-muted">@item.Subline</span>
                            </span>
                            <span class="ms ms-sm ats-faint">chevron_right</span>
                        </a>
                    }
                </div>
            }
        </div>

        @if (User.Can(AtsPermission.IntegrationManage))
        {
            <div class="ats-card-dark">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="ats-board-col-dot @(Model.Integration.Connected ? "ats-dot--on" : "ats-dot--off")"></span>
                    <span class="ats-eyebrow">ReferralTool · @(Model.Integration.Connected ? "connected" : "off")</span>
                </div>
                <p class="ats-small ats-on-dark-muted mb-3">
                    @Model.Integration.Delivered24h delivered, @Model.Integration.Failed24h failed, @Model.Integration.Pending pending.
                </p>
                <a asp-controller="Integration" asp-action="Index" class="btn btn-outline-light btn-sm">
                    Integration health <span class="ms ms-sm">arrow_forward</span>
                </a>
            </div>
        }
    </div>
</div>

<div class="ats-card mt-3">
    <span class="ats-eyebrow">Latest activity:</span>
    <h2 class="mt-1 mb-2">What moved.</h2>
    @if (Model.Activity.Count == 0)
    {
        <p class="ats-small ats-muted mb-0">No activity recorded yet.</p>
    }
    else
    {
        <div class="d-flex flex-column">
            @foreach (var a in Model.Activity)
            {
                <div class="ats-divider-bottom d-flex align-items-center gap-3 py-2">
                    <partial name="Partials/_Avatar" model="new AvatarModel(a.Actor, 2)" />
                    <span class="ats-small flex-grow-1">@a.Text</span>
                    <span class="ats-mono ats-xsmall ats-muted"><local-time utc="@a.OccurredAt" format="time"></local-time></span>
                </div>
            }
        </div>
    }
</div>
