@model Ats.Web.Models.Shared.PipelineBarModel
@{
    var total = Model.Segments.Sum(s => s.Count);
}
@if (total == 0)
{
    <span class="ats-pipebar"><span class="ats-stage-empty" style="flex:1"></span></span>
}
else
{
    <span class="ats-pipebar">
        @for (var i = 0; i < Model.Segments.Count; i++)
        {
            var seg = Model.Segments[i];
            if (seg.Count == 0) { continue; }
            <span class="ats-stage-@(i % 5 + 1)" style="flex:@Math.Max(1, seg.Count)" title="@seg.Count @seg.Label"></span>
        }
    </span>
}
@if (Model.ShowLabels)
{
    <span class="ats-muted ats-xsmall">@string.Join(" · ", Model.Segments.Where(s => s.Count > 0).Select(s => $"{s.Count} {s.Label}"))</span>
}
