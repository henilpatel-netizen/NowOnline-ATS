# Ats — root EditorConfig. Codifies the conventions already used across the solution so the build
# and `dotnet format` enforce a consistent style for a long-lived, multi-developer product.
root = true

# ── All files ────────────────────────────────────────────────────────────────
[*]
charset = utf-8
# Line endings are governed by .gitattributes (`* text=auto`); don't let the formatter fight it.
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,js,css,html,cshtml,csproj,props,targets,slnx,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are generated. Don't hold generated scaffolding to hand-written style rules.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none

# ── C# ───────────────────────────────────────────────────────────────────────
[*.cs]
indent_size = 4
max_line_length = 120

# this. preferences — the codebase does not use this.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Language keywords over BCL type names (int over Int32)
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Modern language features
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:silent
csharp_prefer_braces = true:silent
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_using_directive_placement = outside_namespace:suggestion

# using directives: sort, System first
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Nullable/reference-type correctness stays a warning (build is nullable-clean today).
dotnet_diagnostic.CS8600.severity = warning
dotnet_diagnostic.CS8602.severity = warning
dotnet_diagnostic.CS8603.severity = warning
dotnet_diagnostic.CS8604.severity = warning
dotnet_diagnostic.CS8625.severity = warning

# Remove-unused-usings and unused private members: real cleanliness signals, keep as warnings.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.CA1823.severity = warning

# Noisy stylistic/opinionated analyzer rules → suggestion, so they never fail the build.
# (These would otherwise flag large swaths of idiomatic existing code.)
dotnet_diagnostic.CA1848.severity = none   # Use LoggerMessage delegates
dotnet_diagnostic.CA1727.severity = none   # PascalCase logging template tokens
dotnet_diagnostic.CA1305.severity = suggestion  # IFormatProvider
dotnet_diagnostic.CA1310.severity = suggestion  # StringComparison on Contains/StartsWith
dotnet_diagnostic.CA1861.severity = suggestion  # constant arrays as static readonly
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait (not needed in ASP.NET Core)
dotnet_diagnostic.CA1515.severity = none   # make types internal (MVC needs public controllers)
dotnet_diagnostic.CA1707.severity = none   # underscores in names — deliberate xUnit test-method style
dotnet_diagnostic.CA1725.severity = none   # param-name match — house style keeps `b` (EF config) and `ct`
dotnet_diagnostic.CA1716.severity = none   # namespace vs VB keyword (e.g. `Shared`) — no VB consumers
dotnet_diagnostic.CA1720.severity = none   # identifier contains a type name

# ── Naming: interfaces start with I, types/members PascalCase, private fields _camelCase ──
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_symbols.interface_symbol.applicable_accessibilities = *
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.i_prefix_style.capitalization = pascal_case

dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_rule.types_pascal.symbols = type_symbols
dotnet_naming_rule.types_pascal.style = pascal_style
dotnet_naming_symbols.type_symbols.applicable_kinds = class,struct,enum,property,method,event
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *
dotnet_naming_style.pascal_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_style
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_style.required_prefix = _
dotnet_naming_style.underscore_style.capitalization = camel_case
